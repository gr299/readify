# Database Configuration
# For local development with SQLite (default):
# Leave DATABASE_URL empty and USE_SUPABASE=false or unset

# For production with Supabase:
# Use the Session Pooler URL, not the direct host connection.
# Example:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# USE_SUPABASE=true

DATABASE_URL=
USE_SUPABASE=

# Server Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (for password reset, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
